<% /* Grid schedule template for multi-day events
   Input shape matches templates/schedule.ejs:
   items[0] is an object with keys: tags (map), sessions (array of session objects)
   Each session may have: id, title, day, start, end | duration, tags (array), category, authors, chair, href
   Renders a grid with:
     - First column: time ruler (local timezone), labels every 15 minutes
     - One column per day (day numbers ascending)
     - Rows: 5-minute increments from global earliest start to latest end across all days
*/ %>

<script>
  
  const fmtTime = new Intl.DateTimeFormat(navigator.language || 'en-US', { hour: '2-digit', minute: '2-digit' });

  document.addEventListener("DOMContentLoaded", function() {
    const tz = Intl.DateTimeFormat().resolvedOptions().timeZone;
    const tzEl = document.getElementById('tz-indicator');
    if (tzEl) tzEl.textContent = tz;

    // Helpers
    

    function floorTo(startDate, minutes) {
      const d = new Date(startDate);
      d.setSeconds(0,0);
      const ms = minutes * 60 * 1000;
      return new Date(Math.floor(d.getTime() / ms) * ms);
    }
    function ceilTo(endDate, minutes) {
      const d = new Date(endDate);
      d.setSeconds(0,0);
      const ms = minutes * 60 * 1000;
      return new Date(Math.ceil(d.getTime() / ms) * ms);
    }
    function addDurationISO(startISO, dur) {
      try {
        const start = new Date(startISO);
        const m = /^PT(?:(\d+)H)?(?:(\d+)M)?(?:(\d+)S)?$/.exec(dur || '');
        if (!m) return null;
        const [,h,mn,s] = m.map(x => parseInt(x||'0',10));
        start.setHours(start.getHours() + (h||0));
        start.setMinutes(start.getMinutes() + (mn||0));
        start.setSeconds(start.getSeconds() + (s||0));
        return start;
      } catch { return null; }
    }

  const grid = document.getElementById('grid-schedule');
  const timeCol = grid.querySelector('.grid-body .time-col');
  const body = grid.querySelector('.grid-body');
  const header = grid.querySelector('.grid-header');

    const slotMins = parseInt(grid.getAttribute('data-slot-mins') || '5', 10);
    const rowPx = parseInt(grid.getAttribute('data-row-height') || '8', 10);

    // Collect sessions (numeric-day only)
    const sessEls = Array.from(grid.querySelectorAll('.session-block'));

    // Resolve end times if missing
    for (const el of sessEls) {
      const startISO = el.getAttribute('data-start');
      let endISO = el.getAttribute('data-end');
      const dur = el.getAttribute('data-duration');
      if (!endISO && startISO && dur) {
        const endDate = addDurationISO(startISO, dur);
        if (endDate) endISO = endDate.toISOString();
        if (endISO) el.setAttribute('data-end', endISO);
      }
    }

    // Compute global time bounds across days
    const allStarts = [];
    const allEnds = [];
    for (const el of sessEls) {
      const day = el.getAttribute('data-day');
      if (!day || isNaN(parseInt(day,10))) continue; // skip non-scheduled (day = X)
      const start = new Date(el.getAttribute('data-start'));
      start.setHours(start.getHours() - 24 * day);
      const endAttr = el.getAttribute('data-end');
      const end = endAttr ? new Date(endAttr) : addDurationISO(el.getAttribute('data-start'), el.getAttribute('data-duration'));
      end.setHours(end.getHours() - 24 * day);
      if (!isNaN(start) && !isNaN(end)) {
        allStarts.push(start);
        allEnds.push(end);
      }
    }
    if (!allStarts.length || !allEnds.length) return; // nothing to draw

    const globalStart = floorTo(new Date(Math.min.apply(null, allStarts)), slotMins);
    const globalEnd = ceilTo(new Date(Math.max.apply(null, allEnds)), slotMins);
    const totalMs = globalEnd - globalStart;
    const slotMs = slotMins * 60 * 1000;
    const slots = Math.max(1, Math.round(totalMs / slotMs));

    // Apply grid row sizing to body
    body.style.gridTemplateRows = "repeat("+slots+", "+rowPx+"px)";

    // Build the time ruler (labels every 15 minutes)
    for (let i = 0; i <= slots; i++) {
      const t = new Date(globalStart.getTime() + i * slotMs);
      const showLabel = (i % (15 / slotMins) === 0); // every 15 minutes
      const slot = document.createElement('div');
      slot.className = 'time-slot' + (showLabel ? ' with-label' : '');
      slot.style.gridColumn = '1';
      const rowStart = i + 1; // grid rows are 1-based
      slot.style.gridRow = ""+ rowStart + " / " + (rowStart+1);
      if (showLabel) slot.textContent = fmtTime.format(t);
      timeCol.appendChild(slot);
    }

    // Place sessions in their day columns
  const dayOrder = (grid.getAttribute('data-day-keys') || '').split(',').filter(Boolean);
  // Set dynamic grid columns (time column + one per day)
  const dayCols = Array(dayOrder.length).fill('1fr').join(' ');
  header.style.gridTemplateColumns = "var(--time-col-w) " + dayCols;
  body.style.gridTemplateColumns = "var(--time-col-w) " + dayCols;
  const colOffset = 2; // col 1 is time ruler
  for (const el of sessEls) {
    const day = el.getAttribute('data-day');
    if (!day || isNaN(parseInt(day,10))) { el.style.display = 'none'; continue; }
      const colIndex = dayOrder.indexOf(day);
      if (colIndex < 0) { el.style.display = 'none'; continue; }
      const start = new Date(el.getAttribute('data-start'));
      const end = new Date(el.getAttribute('data-end'));
      start.setHours(start.getHours() - 24 * day);
      end.setHours(end.getHours() - 24 * day);
      if (isNaN(start) || isNaN(end)) { el.style.display = 'none'; continue; }
      const startSlots = Math.floor((start - globalStart) / slotMs);
      const endSlots = Math.ceil((end - globalStart) / slotMs);
      const rowStart = Math.max(1, startSlots + 1);
      const rowEnd = Math.max(rowStart + 1, endSlots + 1);
      el.style.gridColumn = String(colOffset + colIndex);
      el.style.gridRow = ""+ rowStart + " / " + rowEnd;

    // Compose title as "Start - End : <Session type> Title"
    const sessionType = el.getAttribute('data-sessionType');
    const sessionTitle = el.title
    const startStr = fmtTime.format(start);
    const endStr = end && !isNaN(end) ? fmtTime.format(end) : '';
    el.title = startStr + ' - ' + endStr + (sessionType ? ' : ' + sessionType : '') + ' ' + sessionTitle;
    }
  });
</script>

<style>
  .grid-schedule { --time-col-w: 96px; --slot-h: 8px; }
  .grid-header { display: grid; gap: 6px; align-items: end; }
  .grid-body { display: grid; gap: 2px; }
  .grid-header .hdr { font-weight: 600; border-bottom: 1px solid var(--bs-border-color, #ddd); padding-bottom: .25rem; }
  .grid-header .hdr .sub { display:block; font-weight: 400; font-size: .8rem; color: var(--bs-secondary-color, #666); }
  .time-col { display: contents; }
  .time-slot { border-top: 1px dashed #e5e5e5; font-size: .75rem; color: #666; padding-right: .25rem; text-align: right; }
  .time-slot.with-label { color: #333; }
  .session-block { background: var(--bs-light, #f8f9fa); border: 1px solid var(--bs-border-color, #ddd); border-left-width: 4px; border-left-color: var(--bs-primary, #0d6efd);
                   border-radius: 4px; padding: .35rem .5rem; overflow: hidden; }
  .session-title { font-size: .85rem; margin: 0; }
  .session-meta { font-size: .7rem; color: var(--bs-secondary-color, #666); }
  .tag-pill { display:inline-block; font-size:.65rem; padding:.1rem .35rem; border-radius: 999px; background:#eef; color:#225; margin-right:.25rem; }
  .grid-wrap { overflow-x: auto; }
</style>

<div class="small text-muted mb-2">Local time: <span id="tz-indicator"></span></div>

<%
// Extract input structure
const root = items[0] || {};
const tags = root.tags || {};
let sessions = (root.sessions || []).slice();

// compute end from duration server-side if missing
function addDuration(startISO, duration) {
  const start = new Date(startISO);
  const match = /^PT(?:(\d+)H)?(?:(\d+)M)?(?:(\d+)S)?$/.exec(duration || '');
  if (!match) return null;
  const [, h, m, s] = match.map(x => parseInt(x || '0', 10));
  start.setHours(start.getHours() + (h || 0));
  start.setMinutes(start.getMinutes() + (m || 0));
  start.setSeconds(start.getSeconds() + (s || 0));
  return start.toISOString();
}
for (const s of sessions) {
  if (!s.end && s.start && s.duration) s.end = addDuration(s.start, s.duration);
}

// Only numeric days are plotted; others (e.g., 'X') are ignored
const byDay = {};
for (const s of sessions) {
  const d = String(s.day);
  if (!/^\d+$/.test(d)) continue;
  if (!byDay[d]) byDay[d] = [];
  byDay[d].push(s);
}
const dayKeys = Object.keys(byDay).sort((a,b)=>parseInt(a)-parseInt(b));
const dayNames = templateParams && templateParams.days ? templateParams.days : {};
%>

<div class="grid-wrap">
  <div id="grid-schedule" class="grid-schedule" data-slot-mins="5" data-row-height="8" data-day-keys="<%= dayKeys.join(',') %>">
    <div class="grid-header">
      <div class="hdr">Time</div>
      <% for (const d of dayKeys) { %>
        <div class="hdr">Day <%= d %><span class="sub"><%= dayNames[d] || '' %></span></div>
      <% } %>
    </div>

    <div class="grid-body">
      <div class="time-col"></div>

      <% // Render session blocks; positioned later by JS via grid-row/grid-column %>
      <% for (const d of dayKeys) { %>
        <% const list = byDay[d].sort((a,b)=> new Date(a.start) - new Date(b.start)); %>
        <% for (const s of list) { %>
        <% const classes = ['session-block', 'rounded', ...s.sessionType]; %>
          <div class="<%= classes.join(' ') %>" 
            data-sessionType="<%= s.sessionType.join(', ') %>"
            data-day="<%= d %>" 
            data-start="<%- s.start %>" 
            data-end="<%- s.end || '' %>" 
            data-duration="<%- s.duration || '' %>"
            title="<%= s.title %>"
            >
            <p class="session-title"><%= s.title %></p>
            <div class="session-meta">              
              <% if (s.authors) { %><span class="me-2"><%= Array.isArray(s.authors) ? s.authors.map(a => `<strong>${a}</strong>` ).join(', ') : s.authors %></span><% } %>
              <% if (s.chair) { %><span class="me-2">Chair: <%= s.chair %></span><% } %>
              <% if (s.category) { %><span class="me-2">[<%= s.category %>]</span><% } %>
            </div>
            <% if (s.tags && s.tags.length) { %>
              <div class="mt-1">
                <% for (const t of s.tags) { %>
                  <span class="tag-pill"><%= tags[t] || t %></span>
                <% } %>
              </div>
            <% } %>
          </div>
        <% } %>
      <% } %>

    </div>
  </div>
</div>
